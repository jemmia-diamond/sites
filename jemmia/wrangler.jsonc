{
  "name": "jemmia-sites-home",
  "main": "src/index.js",
  "compatibility_date": "2026-05-25",
  "vars": {
    "GA4_API_URL": "https://www.google-analytics.com"
  },
  "routes": [
    {
      "pattern": "jemmia.vn/*",
      "zone_name": "jemmia.vn"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt",
        "**/*.md"
      ],
      "fallthrough": true
    }
  ]
}
